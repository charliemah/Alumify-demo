# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alumify

# API
PORT=3001
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated origins for production (e.g. https://app.example.com). Omit or leave empty for dev (allow all).
CORS_ORIGIN=

# Password reset & email verification (Resend)
APP_URL=http://localhost:3000
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
